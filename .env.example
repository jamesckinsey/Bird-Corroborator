# Set PORT to the host port published by the existing birdnet-go container.
BIRDNET_BASE_URL=http://host.docker.internal:PORT
BIRDNET_DETECTIONS_PATH=/api/v2/detections
BIRDNET_RECENT_PATH=/api/v2/detections/recent
BIRDNET_PING_PATH=/api/v2/ping
BIRDNET_POLL_SECONDS=300
BIRDNET_CATCHUP_HOURS=12
BIRDNET_PAGE_SIZE=100
HOME_LATITUDE=
HOME_LONGITUDE=
BIRDWEATHER_GRAPHQL_URL=https://app.birdweather.com/graphql
BIRDWEATHER_RADIUS_MILES=10
BIRDWEATHER_LOOKBACK_HOURS=24
BIRDWEATHER_CACHE_MINUTES=15
BIRDWEATHER_TIMEOUT_SECONDS=15
ENRICHMENT_RETRY_SECONDS=900
ENRICHMENT_MAX_ATTEMPTS=12
ENRICHMENT_CONCURRENCY=1
LOAD_SHEDDING_ENABLED=true
LOAD_SHEDDING_THRESHOLD=3.0
IMAGE_PROVIDER_API_URL=https://commons.wikimedia.org/w/api.php
IMAGE_CACHE_DIR=/data/species-images
IMAGE_RETRY_HOURS=24
IMAGE_THUMBNAIL_WIDTH=640
IMAGE_MAX_BYTES=5000000
LOCAL_TIMEZONE=America/New_York
DATABASE_URL=sqlite:////data/birds.db
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
WORKER_ENABLED=true
